{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "dev-standards: ミューテーションテスト（.claude/rules/testing.md §10）。mutate は製品のコードの置き場所に合わせる。判定は tools/mutation_gate.py が行うので break は置かない",
  "testRunner": "vitest",
  "vitest": { "configFile": "vitest.mutation.config.ts" },
  "mutate": ["src/**/*.ts"],
  "reporters": ["clear-text", "progress", "html", "json"],
  "htmlReporter": { "fileName": "out/mutation/mutation.html" },
  "jsonReporter": { "fileName": "out/mutation/mutation.json" },
  "incremental": true,
  "incrementalFile": "out/mutation/stryker-incremental.json",
  "thresholds": { "high": 80, "low": 60, "break": null }
}
